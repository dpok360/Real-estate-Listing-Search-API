  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start:watch": "nodemon dist/server.js",
    "start:dev": "nodemon --exec ts-node --type-check -r ./src/server.ts",
    "start:transpile": "nodemon --exec ts-node --transpileOnly src/server.ts",
    "start": "node dist/server.js",
    "clean": "rm -rf ./dist",
    "test": "jest --runInBand"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/module-alias": "^2.0.4",
    "@types/supertest": "^6.0.3",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "prettier": "3.8.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.4",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "module-alias": "^2.3.4",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "ts-node": "^10.9.2"
  },
  "lint-staged": {
    "**/*.{js,ts,json}": [
      "npx prettier --write"
    ]
  },
  "_moduleAliases": {
    "@src": "dist"
  }
